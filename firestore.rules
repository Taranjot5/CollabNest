rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'super_admin';
    }

    function bootstrapExists() {
      return exists(/databases/$(database)/documents/system/bootstrap);
    }

    function isActiveUser() {
      return isSignedIn()
        && (!('status' in userDoc().data) || userDoc().data.status == 'active');
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }

    function isWorkspaceAdmin(workspaceId) {
      let ws = get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
      return isWorkspaceMember(workspaceId)
        && (request.auth.uid == ws.ownerId
          || request.auth.uid in ws.admins);
    }

    // ── Bootstrap (public read for registration gate) ─────
    match /system/bootstrap {
      allow read: if true;
      allow create: if isSignedIn()
        && !bootstrapExists()
        && request.resource.data.initialized == true
        && request.resource.data.superAdminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && (
        isSuperAdmin()
        || (
          request.auth.uid == userId
          && !bootstrapExists()
          && request.resource.data.role == 'super_admin'
          && request.resource.data.status == 'active'
        )
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
        || isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ── Workspaces ─────────────────────────────────────────
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow create: if isActiveUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isWorkspaceAdmin(workspaceId) || isSuperAdmin();
      allow delete: if (isSignedIn()
          && resource.data.ownerId == request.auth.uid) || isSuperAdmin();
    }

    // ── Notes ──────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && (resource.data.workspaceId == ''
          || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.participants;
      allow update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && (resource.data.workspaceId == ''
          || isWorkspaceMember(resource.data.workspaceId));
    }

    // ── Folders ────────────────────────────────────────────
    match /folders/{folderId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId) || isSuperAdmin();
      allow create: if isActiveUser()
        && isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId) || isSuperAdmin();
    }

    // ── Comments ───────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser();
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Note Versions ──────────────────────────────────────
    match /noteVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isActiveUser();
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.receiverId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && resource.data.receiverId == request.auth.uid;
    }

    // ── Tasks ──────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants
        || userRole() in ['super_admin', 'admin', 'senior']
      );
      allow create: if isSignedIn()
        && userRole() in ['super_admin', 'admin', 'senior'];
      allow update: if isSignedIn() && (
        userRole() in ['super_admin', 'admin', 'senior']
        || request.auth.uid in resource.data.assigneeIds
      );
      allow delete: if isSignedIn()
        && userRole() in ['super_admin', 'admin', 'senior'];
    }

    match /taskComments/{id} {
      allow read, write: if isSignedIn();
    }

    match /taskActivities/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // ── Workspace Activities ───────────────────────────────
    match /workspaceActivities/{id} {
      allow read: if isWorkspaceMember(resource.data.workspaceId) || isSuperAdmin();
      allow create: if isSignedIn();
    }

    // ── Audit Logs (admin only) ────────────────────────────
    match /auditLogs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
    }
  }
}
